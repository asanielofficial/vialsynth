<?xml version="1.0" encoding="utf-8"?>
<!-- Installer for the VialSynth macOS package (built by .github/workflows/build.yml with productbuild). -->
<installer-gui-script minSpecVersion="2">
  <title>VialSynth</title>
  <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
  <choices-outline>
    <line choice="vst3"/>
  </choices-outline>
  <choice id="vst3" title="VST3 plugin" description="Installs VialSynth.vst3 to /Library/Audio/Plug-Ins/VST3." start_selected="true">
    <pkg-ref id="com.vialsynth.vst3"/>
  </choice>
  <pkg-ref id="com.vialsynth.vst3" version="1.0" onConclusion="none">vst3.pkg</pkg-ref>
</installer-gui-script>
