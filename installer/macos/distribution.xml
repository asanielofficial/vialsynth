<?xml version="1.0" encoding="utf-8"?>
<!-- Installer choices for the VialSynth macOS package (built by .github/workflows/build.yml with productbuild). -->
<installer-gui-script minSpecVersion="2">
  <title>VialSynth</title>
  <options customize="always" require-scripts="false" hostArchitectures="x86_64,arm64"/>
  <choices-outline>
    <line choice="vst3"/>
    <line choice="clap"/>
    <line choice="au"/>
  </choices-outline>
  <choice id="vst3" title="VST3 plugin" description="Installs VialSynth.vst3 to /Library/Audio/Plug-Ins/VST3." start_selected="true">
    <pkg-ref id="com.vialsynth.vst3"/>
  </choice>
  <choice id="clap" title="CLAP plugin" description="Installs VialSynth.clap to /Library/Audio/Plug-Ins/CLAP." start_selected="true">
    <pkg-ref id="com.vialsynth.clap"/>
  </choice>
  <choice id="au" title="Audio Unit plugin" description="Installs VialSynth.component to /Library/Audio/Plug-Ins/Components." start_selected="true">
    <pkg-ref id="com.vialsynth.au"/>
  </choice>
  <pkg-ref id="com.vialsynth.vst3" version="1.3" onConclusion="none">vst3.pkg</pkg-ref>
  <pkg-ref id="com.vialsynth.clap" version="1.3" onConclusion="none">clap.pkg</pkg-ref>
  <pkg-ref id="com.vialsynth.au" version="1.3" onConclusion="none">au.pkg</pkg-ref>
</installer-gui-script>
